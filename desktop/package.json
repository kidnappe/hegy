{
  "name": "hegy",
  "productName": "何解",
  "version": "1.2.2",
  "private": true,
  "description": "何解 · 动态几何解题（桌面便携版）",
  "author": "zhouxuan and Hegy contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidnappe/hegy.git"
  },
  "homepage": "https://github.com/kidnappe/hegy#readme",
  "bugs": {
    "url": "https://github.com/kidnappe/hegy/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/patch-portable-nsis.js && electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:all": "npm run dist && npm run dist:installer",
    "dist:arm64": "node tools/patch-portable-nsis.js && electron-builder --win portable --arm64 -c.directories.output=dist-arm64 && node tools/rename-arm64.js"
  },
  "devDependencies": {
    "electron": "^26.6.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hegy.app",
    "productName": "何解",
    "asar": false,
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "portable": {
      "artifactName": "何解-${version}-便携版.${ext}",
      "useZip": true,
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "何解",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "何解-${version}-安装版.${ext}",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      { "from": "../LICENSE", "to": "app/LICENSE" }
    ],
    "files": [
      "main.js",
      "preload.js",
      { "from": "../solver", "to": "solver", "filter": [
        "**/*",
        "!shot_*",
        "!shot.js",
        "!shot2.js",
        "!shot3.js",
        "!_export_test.html",
        "!_rec*",
        "!_refs.txt",
        "!export_*.png",
        "!icon-prompts.md",
        "!mock.js",
        "!config.example.json",
        "!*.log",
        "!*.bak",
        "!config.json",
        "!example_*.js"
      ] }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    }
  }
}
