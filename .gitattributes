# 默认按文本处理；Git 会在索引里统一换行，工作区保持平台习惯。
* text=auto

# Windows 脚本必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
*.wav binary
*.mp3 binary
*.zip binary

